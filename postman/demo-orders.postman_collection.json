{
  "info": {
    "_postman_id": "6f1c2a4e-0d1b-4c8e-9a51-3d2e0f7b8c14",
    "name": "Acme Orders — demo order API",
    "description": "The demo order API served by the console under /demo/api: sign in for a Bearer token, then create, pay and read back an order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Orders",
      "description": "Login → create → pay → get. Login stores the token in the collection variable `token`; create stores `orderId`.",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"login succeeds\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test(\"a token is issued\", function () {",
                  "    pm.expect(json.token).to.be.a(\"string\");",
                  "});",
                  "pm.collectionVariables.set(\"token\", json.token);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/demo/api/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "demo",
                "api",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"order is created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test(\"status is created\", function () {",
                  "    pm.expect(json.status).to.eql(\"created\");",
                  "});",
                  "pm.test(\"total is unit price times quantity\", function () {",
                  "    pm.expect(json.total).to.eql(160);",
                  "});",
                  "pm.collectionVariables.set(\"orderId\", json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"sku\": \"GADGET\", \"qty\": 2 }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/demo/api/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "demo",
                "api",
                "orders"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Pay order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"payment is accepted\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"status is paid\", function () {",
                  "    pm.expect(pm.response.json().status).to.eql(\"paid\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/demo/api/orders/{{orderId}}/pay",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "demo",
                "api",
                "orders",
                "{{orderId}}",
                "pay"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"order is found\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test(\"the payment was saved\", function () {",
                  "    pm.expect(json.status).to.eql(\"paid\");",
                  "});",
                  "pm.test(\"it is the order just created\", function () {",
                  "    pm.expect(json.id).to.eql(pm.collectionVariables.get(\"orderId\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/demo/api/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "demo",
                "api",
                "orders",
                "{{orderId}}"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// The collection sets no sign-in, so an environment's auth preset signs these requests in.",
          "// With none, every request after Login sends the token Login stored.",
          "var token = pm.collectionVariables.get(\"token\");",
          "if (token && pm.info.requestName !== \"Login\" && !pm.request.headers.has(\"Authorization\")) {",
          "    pm.request.headers.add({ key: \"Authorization\", value: \"Bearer \" + token });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "username",
      "value": "tester",
      "type": "string"
    },
    {
      "key": "password",
      "value": "{{apiPassword}}",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "",
      "type": "any"
    }
  ]
}
